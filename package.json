{
  "name": "dsh-session-recycle-bin",
  "version": "0.4.0",
  "description": "Session recycle bin for DeepSeek Harness: restore, permanent delete, and active-session protection. · DSH 会话回收站。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.css",
    "cordis.patch.yml",
    "packages/session-trash-host/lib",
    "packages/session-trash-host/package.json"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "trash",
    "recycle-bin",
    "session-management"
  ],
  "repository": "https://github.com/Seetraum/harness-session-delete",
  "homepage": "https://github.com/Seetraum/harness-session-delete#readme",
  "bugs": {
    "url": "https://github.com/Seetraum/harness-session-delete/issues"
  },
  "dsh": {
    "displayName": "DSH Session Recycle Bin / 会话回收站",
    "description": "Session recycle bin with restore, permanent deletion, and active-session protection. · 会话回收站、还原、彻底删除与活跃会话保护。",
    "homepage": "https://github.com/Seetraum/harness-session-delete",
    "repository": "https://github.com/Seetraum/harness-session-delete",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "prepublishOnly": "npm test",
    "verify:host": "node scripts/verify-real-host.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
